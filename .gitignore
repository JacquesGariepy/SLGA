# ============================================================================
# Keep These Files (Explicit Inclusions)
# ============================================================================
# Configuration files that SHOULD be committed
!pyproject.toml
!pytest.ini
!.coveragerc
!.pre-commit-config.yaml
!.pylintrc
!.github/

# Documentation that SHOULD be committed
!docs/**/*.md
!README.md
!LICENSE
!CONTRIBUTING.md

# Example files
!examples/**
docs/hive-mind/quality-analysis-report.md
docs/REORGANIZATION_SUMMARY.md
.github/workflows/quality.yml
archive/
