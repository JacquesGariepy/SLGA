seed: 1234
device: cuda

model:
  vocab_size: 50257
  max_seq_len: 2048
  embed_dim: 512              # Capacité augmentée pour meilleure performance
  num_heads: 8                # Plus de têtes d'attention
  ff_hidden_multiplier: 4     # FFN expansion standard
  n_layers: 12                # Plus de couches pour capacité
  dropout_rate: 0.1
  
  # Configuration attention locale-globale
  local_window: 128           # Fenêtre locale plus large
  global_k: 24                # Top-K global (réduit, suffisant théoriquement)
  gated_fusion: true          # Fusion apprise local/global
  learned_landmarks: true     # Sélection apprise des landmarks
  dilated_windows: true       # Fenêtres dilatées par couche
  diverse_topk: true          # Top-K avec diversité inter-têtes

train:
  # Curriculum d'apprentissage progressif
  seq_len_start: 512          # Commencer avec séquences courtes
  seq_len_mid: 1024           # Phase intermédiaire
  seq_len_final: 2048         # Objectif final
  seq_len_warmup_steps: 15000 # Étapes pour atteindre seq_len_final
  
  batch_size: 4               # Micro-batch pour 3090
  accum_steps: 16             # Effective batch = 64
  lr: 2.0e-4                  # Learning rate initial
  betas: [0.9, 0.95]          # Adam betas
  eps: 1.0e-8
  weight_decay: 0.1
  warmup_steps: 1000           # LR warmup 5000
  max_steps: 100000
  grad_clip: 1.0
  
  # Optimisations mémoire/vitesse
  amp: true                   # Automatic Mixed Precision
  amp_dtype: "bf16"           # bfloat16 si supporté, sinon fp16
  grad_checkpointing: true    # Activer pour seq_len > 1024
  torch_compile: false        # Peut être activé manuellement (instable parfois)
  
  # Configuration collator
  collator: "local"           # "local" si learned_landmarks=true, sinon "global"
  global_every: 128           # Pour collator global: landmarks tous les N tokens
  max_global: 64              # Nombre max de landmarks globaux
  
  # Pénalités auxiliaires pour landmarks appris
  lambda_diversity: 0.02      # Encourage diversité spatiale des landmarks
  lambda_sparsity: 0.001      # Pénalise trop de landmarks actifs
  
  # Phase de warmup du global attention
  global_warmup_start: 30000  # Étape où commence l'activation du global
  global_warmup_end: 50000    # Étape où le global est pleinement actif
  
  # Sauvegarde et évaluation
  save_every: 2000
  eval_every: 1000
  log_every: 100

data:
  dataset: "wikimedia/wikipedia"
  subset: "20231101.en"       # Version récente de Wikipedia
  split_train: "train"
  split_val: "validation"
  num_workers: 4              # Parallélisation du chargement
  max_train_samples: null     # null = tout le dataset
  max_val_samples: 10000      # Limiter validation pour rapidité

tokenizer: "gpt2"

save:
  out_dir: "out_slga"

log:
  wandb: false                # Activer pour suivi W&B
  project: "slga-plus"
  run_name: null              # Auto-généré si null
  tensorboard: true